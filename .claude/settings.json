{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "Co-Authored-By: Claude <noreply@anthropic.com>",
    "pr": "🤖 Generated with [Claude Code](https://claude.com/claude-code)"
  },
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run test)",
      "Bash(npm run check)",
      "Bash(npm run build)",
      "Bash(npm test *)",
      "Bash(npm run test:coverage *)",
      "Bash(npm --prefix * test)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch)",
      "Bash(git branch --list *)",
      "Bash(git branch -a)",
      "Bash(git branch -vv)",
      "Bash(git -C * status *)",
      "Bash(git -C * diff *)",
      "Bash(git -C * log *)",
      "Bash(git -C * branch --list *)",
      "Bash(git fetch)",
      "Bash(git fetch origin)",
      "Bash(git fetch --all --prune)",
      "Bash(git fetch origin --prune)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(node scripts/route-weight.mjs)",
      "Bash(node scripts/route-weight.mjs *)",
      "Bash(node --test *)",
      "Bash(npm run test:scripts)",
      "Bash(npm run e2e -w @poe2/web)",
      "Bash(npm run e2e -w @poe2/web *)",
      "Bash(npm run build -w *)"
    ],
    "ask": [
      "Bash(gh pr merge *)",
      "PowerShell(gh pr merge *)",
      "mcp__github__merge_pull_request",
      "mcp__github__enable_pr_auto_merge",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "PowerShell(Remove-Item * -Recurse -Force*)",
      "PowerShell(Remove-Item * -Force -Recurse*)"
    ],
    "deny": [
      "Bash(git push * main)",
      "Bash(git push * HEAD:main)",
      "Bash(git push *:main)",
      "Bash(git push *refs/heads/main*)",
      "PowerShell(git push * main)",
      "PowerShell(git push *:main)",
      "PowerShell(git push *refs/heads/main*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "Bash(git push --delete *)",
      "Bash(git push * --delete *)",
      "PowerShell(git push --delete *)",
      "PowerShell(git push * --delete *)",
      "Bash(git branch -D *)",
      "PowerShell(git branch -D *)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(packages/data/generated/**)",
      "Read(packages/data/trade2-stats.json)",
      "Read(packages/core/test/fixtures/*-v*.json)",
      "Read(vendor/pob2/src/Data/**)",
      "Read(vendor/pob2/src/TreeData/**)"
    ]
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/claude-plugins-official.git"
      }
    }
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-generated-edits.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] && bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/cloud-setup.sh\" || true",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
