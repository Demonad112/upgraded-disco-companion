// Cloudflare Containers deploy of services/pob-engine: a Worker in front of one container instance (PoB stays loaded
// and its answer cache is shared). Deployed by .github/workflows/pob-engine-deploy.yml (the runner has Docker to build
// the image); locally: `npm ci && npx wrangler deploy` here with Docker running.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pob-engine",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "PobEngine",
      // Paths are relative to this file. The image copies vendor/pob2 and tools/pob2, so it builds from the repo root.
      "image": "../Dockerfile",
      "image_build_context": "../../..",
      // 1 vCPU, 6 GiB: one PoB worker holds ~700 MB; a build takes ~8 s at 1 vCPU (CI runner), ~16 s at 1/2.
      "instance_type": "standard-2",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ENGINE", "class_name": "PobEngine" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PobEngine"] }]
}
